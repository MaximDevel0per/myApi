# Kopiere diese Datei nach .env und trage echte Werte ein.
# .env selbst ist per .gitignore ausgeschlossen und gehoert nie ins Repository.

# --- Laufzeit ---
NODE_ENV=development
PORT=3000

# Pfad zur SQLite-Datei. ":memory:" fuer eine fluechtige Datenbank (Tests).
DATABASE_PATH=notes.db

# --- Authentifizierung ---
# Mindestens 32 Zeichen. Erzeugen mit:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=bitte-ersetzen-durch-mindestens-32-zufaellige-zeichen
JWT_EXPIRES_IN=1h

# --- Externe APIs (fuer /api/v1/weather) ---
# https://openweathermap.org/api  -> kostenloser API-Key
OPENWEATHER_API_KEY=key
# https://geocode.maps.co/        -> kostenloser API-Key
GEOCODING_API_KEY=key
